<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Grpc.HealthCheck</id>
    <version>2.83.0</version>
    <authors>The gRPC Authors</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>packageIcon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/grpc/grpc-dotnet</projectUrl>
    <description>gRPC C# Health Checking</description>
    <copyright>Copyright 2019 The gRPC Authors</copyright>
    <tags>gRPC health check</tags>
    <repository type="git" url="https://github.com/grpc/grpc-dotnet.git" commit="4301104498e53898a452e8fb2fea6c0b1492b755" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Grpc.Core.Api" version="2.83.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="3.31.1" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Channels" version="4.6.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Grpc.Core.Api" version="2.83.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="3.31.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Grpc.Core.Api" version="2.83.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="3.31.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Grpc.Core.Api" version="2.83.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="3.31.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Grpc.Core.Api" version="2.83.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="3.31.1" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Channels" version="4.6.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.6.2" />
      <frameworkAssembly assemblyName="System" targetFramework=".NETFramework4.6.2" />
    </frameworkAssemblies>
  </metadata>
</package>