@page "/account/logout"
@using ui.Auth
@using ui.Models
@inject UIAuthenticationService Auth
@inject NavigationManager Navigation

<PageTitle>Logout</PageTitle>

<h1>Logout</h1>

<EditForm Model="@Model" FormName="logout" OnValidSubmit="LogoutAsync">
    <p>Log out?</p>
    <button type="submit" class="btn btn-danger">Logout</button>
    <a href="/">Cancel</a>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext HttpContext {get; set;} = default!;

    // MEMO: To avoid use directly nullable param with SupplyParameterFromForm
    [SupplyParameterFromForm(Name = nameof(Model))]
    private LogoutFormModel? FormModel {get; set;}
    private LogoutFormModel Model => FormModel ??= new();

    private async Task LogoutAsync()
    {
      await Auth.LogoutAsync(HttpContext, HttpContext.RequestAborted);
      Navigation.NavigateTo("/account/login", forceLoad: true);
    }
}
