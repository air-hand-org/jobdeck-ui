@page "/jobs/{JobId}/delete"
@rendermode InteractiveWebAssembly
@using ui.Models
@using ui.Client
@inject IJobPageClient PageClient
@inject ILogger<Delete> Logger
@inject NavigationManager NavigationManager

<PageTitle>Delete Job</PageTitle>

<h1>Delete Job</h1>

<p>
  <a href="/jobs">Back to list</a>
</p>

@if (_errorMessage is not null)
{
    <p role="alert">@_errorMessage</p>
    <a href="" data-enhance-nav="false">Reload and check the result</a>
}

@if (_job is null)
{
    <p>Loading...</p>
}
else
{
    <p>Are you sure you want to delete this job?</p>

    <dl>
        <dt>Name</dt>
        <dd>@_job.Name</dd>

        <dt>ID</dt>
        <dd>@_job.Id</dd>
    </dl>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    <button class="btn btn-danger" disabled="@(!_isInteractive || _submitted)" @onclick="DeleteJob">Delete</button>
}

@code {
    [Parameter]
    public string JobId {get; set;} = "";

    [PersistentState]
    public ApiResult<JobView>? InitialJob { get; set; }

    private JobView? _job;
    private bool _isInteractive;
    private bool _submitted;

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var result = InitialJob ??= await PageClient.GetJobAsync(JobId);
        if (!result.IsSuccess)
        {
            if (result.Error!.Code == ApiErrorCode.Unauthenticated)
            {
                NavigationManager.NavigateTo("/account/login", forceLoad: true);
            } else {
                _errorMessage = result.Error.Message;
            }
            return;
        }
        _job = result.Value!;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            StateHasChanged();
        }
    }

    private async Task DeleteJob()
    {
        if (_submitted)
        {
            return;
        }
        _submitted = true;
        _errorMessage = null;
        var result = await PageClient.DeleteJobAsync(JobId);
        if (!result.IsSuccess)
        {
            if (result.Error!.Code == ApiErrorCode.Unauthenticated)
            {
                NavigationManager.NavigateTo("/account/login", forceLoad: true);
            } else {
                _errorMessage = result.Error.Message;
            }
            return;
        }
        NavigationManager.NavigateTo("/jobs");
    }
}
