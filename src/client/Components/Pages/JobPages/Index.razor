@page "/jobs"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.QuickGrid
@using Jobdeck.Job.V1
@using ui.Client
@inject BrowserJobClient JobApiClient
@inject NavigationManager Navigation

<PageTitle>Jobs</PageTitle>

<h1>Jobs list</h1>

<p>
  <a href="/jobs/new">Create New</a>
</p>

@if (_errorMessage is not null)
{
  <div class="alert alert-danger" role="alert">@_errorMessage</div>
  <button type="button" class="btn btn-secondary" @onclick="LoadJobsAsync">Retry read</button>
}

<QuickGrid Class="table" Items="_jobs.AsQueryable()">
  <PropertyColumn Property="job => job.Name" Title="Name" />
  <PropertyColumn Property="job => job.Enabled" Title="Enabled" />

  <TemplateColumn Context="job" Title="Links">
    <a href="@($"/jobs/{job.Id}")">Details</a> |
    <a href="@($"/jobs/{job.Id}/edit")">Edit</a> |
    <a href="@($"/jobs/{job.Id}/delete")">Delete</a> |
    <a href="@($"/jobs/{job.Id}/executions")">Executions</a>
  </TemplateColumn>
</QuickGrid>

@code {
  private List<Job> _jobs = [];

  private string? _errorMessage;

  protected override Task OnInitializedAsync() => LoadJobsAsync();

  private async Task LoadJobsAsync()
  {
    _errorMessage = null;
    var result = await JobApiClient.ListJobsAsync();
    if (!result.IsSuccess)
    {
        if (result.Error!.Code == ApiErrorCode.Unauthenticated)
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
        }
        else
        {
            _errorMessage = result.Error!.Message;
        }
        return;
    }

    _jobs = [.. result.Value!.Jobs];
  }
}
