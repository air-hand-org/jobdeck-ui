@page "/jobs/{JobId}/executions"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.QuickGrid
@using ui.Models
@using ui.Client
@inject JobApiClient JobApiClient
@inject ExecutionApiClient ExecutionApiClient
@inject NavigationManager NavigationManager
@inject ILogger<Executions> Logger
@implements IAsyncDisposable

<PageTitle>Executions</PageTitle>

<h1>Executions: @_job?.Name</h1>

<p>
  <a href="/jobs">Back to list</a>
</p>

<div>
  <p>@_errorMessage</p>
  <p>
    <button type="button" class="btn btn-primary" disabled="@(!_isInteractive || _requesting || _uncertain)" @onclick="RequestExecution">Request to run the job</button>
  </p>
</div>

<QuickGrid Class="table" Items="_execs.AsQueryable()">
  <PropertyColumn Property="exec => exec.Id" Title="Id" />
  <PropertyColumn Property="exec => exec.Attempt" Title="Attempt" />
  <PropertyColumn Property="exec => exec.Status" Title="Status" />
  <PropertyColumn Property="exec => FormatDateTime(exec.CreatedAt)" Title="CreatedAt" />
  <PropertyColumn Property="exec => FormatDateTime(exec.UpdatedAt)" Title="UpdatedAt" />
  <TemplateColumn Context="exec" Title="Result">
    <pre class="bg-light border rounded p-2 small mb-0">
        @FormatResult(exec)
    </pre>
  </TemplateColumn>
</QuickGrid>

@code {
  [Parameter]
  public string JobId {get; set;} = "";

  private JobView? _job;
  private List<ExecutionView> _execs = [];
  private string? _errorMessage;
  private bool _isInteractive;
  private bool _requesting;
  private bool _uncertain;

  private readonly CancellationTokenSource _cts = new();
  private Task? _refreshTask;

  protected override async Task OnInitializedAsync()
  {
    var result = await JobApiClient.GetJobAsync(JobId, _cts.Token);
    if (!result.IsSuccess)
    {
        if (result.Error!.Code == ApiErrorCode.Unauthenticated)
        {
            NavigationManager.NavigateTo("/account/login", forceLoad: true);
        } else {
            NavigationManager.NavigateTo("/jobs");
        }
        return;
    }

    _job = result.Value!;
    await LoadExecutionsAsync();
  }

  protected override void OnAfterRender(bool firstRender)
  {
    // The first render can precede the asynchronous job read in WASM.
    if (_refreshTask is null && _job is not null)
    {
        _refreshTask = RefreshLoopAsync(_cts.Token);
    }
    if (!_isInteractive)
    {
        _isInteractive = true;
        StateHasChanged();
    }
  }

  private async Task RefreshLoopAsync(CancellationToken token)
  {
    using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

    try
    {
        while (await timer.WaitForNextTickAsync(token))
        {
            await InvokeAsync(async() =>
            {
                await LoadExecutionsAsync();
                // Re-rendering request to blazor
                StateHasChanged();
            });
        }
    }
    catch (OperationCanceledException)
        when (token.IsCancellationRequested)
    {
        Logger.LogInformation("cancelled");
    }
  }

  public async ValueTask DisposeAsync()
  {
    await _cts.CancelAsync();

    if (_refreshTask is not null)
    {
        await _refreshTask;
    }

    _cts.Dispose();
  }

  private async Task LoadExecutionsAsync()
  {
    _errorMessage = null;

    var result = await ExecutionApiClient.ListExecutionsAsync(jobId: JobId, pageSize: 100, cancellationToken: _cts.Token);
    if (!result.IsSuccess)
    {
        if (result.Error!.Code == ApiErrorCode.Unauthenticated)
        {
            NavigationManager.NavigateTo("/account/login", forceLoad: true);
        } else {
            _errorMessage = result.Error!.Message;
        }
        return;
    }

    _execs = [.. result.Value!.Executions];
  }

  private string FormatDateTime(DateTime? dt)
  {
    return dt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-";
  }

  private string FormatResult(ExecutionView execution)
  {
    if (execution.Result is null)
    {
        return "-";
    }
    return execution.Result;
  }

  private async Task RequestExecution()
  {
    if (_requesting || _uncertain)
    {
        return;
    }
    _requesting = true;
    _errorMessage = null;
    var result = await ExecutionApiClient.DoExecutionAsync(JobId, _cts.Token);
    _requesting = false;
    _uncertain = result.Error?.Code == ApiErrorCode.Internal;
    if (!result.IsSuccess)
    {
        if (result.Error!.Code == ApiErrorCode.Unauthenticated)
        {
            NavigationManager.NavigateTo("/account/login", forceLoad: true);
        } else {
            _errorMessage = result.Error.Message;
        }
        return;
    }

  }
}
