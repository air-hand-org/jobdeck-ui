@page "/jobs/{JobId}/edit"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using ui.Models
@using ui.Client
@inject JobApiClient JobApiClient
@inject NavigationManager NavigationManager

@if (_loaded)
{
<div class="row">
  <div class="col-md-4">
    <HttpJobForm Model="@_model" OnValidSubmit="@UpdateJob" FormName="UpdateJob" SubmitText="Update" ErrorMessage="@_errorMessage" />
  </div>
</div>

}
else if (_errorMessage is not null)
{
  <p role="alert">@_errorMessage</p>
  <button type="button" @onclick="LoadJobAsync">Retry read</button>
}

<div>
  <a href="/jobs">Back to list</a>
</div>

@code {
  [Parameter]
  public string JobId {get; set;} = "";

  private HttpJobFormModel _model = new();
  private string? _errorMessage;

  private bool _loaded;

  protected override Task OnInitializedAsync() => LoadJobAsync();

  private async Task LoadJobAsync()
  {
    _errorMessage = null;

    var result = await JobApiClient.GetJobAsync(JobId);
    if (!result.IsSuccess)
    {
        if (result.Error!.Code == ApiErrorCode.Unauthenticated)
        {
            NavigationManager.NavigateTo("/account/login", forceLoad: true);
        } else {
            _errorMessage = result.Error.Message;
        }
        return;
    }

    _model = result.Value!.Form;
    _loaded = true;
  }

  private async Task UpdateJob()
  {
    _errorMessage = null;
    var result = await JobApiClient.UpdateJobAsync(JobId, _model);
    if (!result.IsSuccess)
    {
        if (result.Error!.Code == ApiErrorCode.Unauthenticated)
        {
            NavigationManager.NavigateTo("/account/login", forceLoad: true);
        } else {
            _errorMessage = result.Error.Message;
        }
        return;
    }

    NavigationManager.Refresh();
  }
}
